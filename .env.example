LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
# Comma-separated YouTube Data API v3 keys; tried in order if one fails.
YOUTUBE_API_KEYS=project-one-key,project-two-key
# Legacy single-key option (used when YOUTUBE_API_KEYS is unset):
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# Optional executable overrides; yt-dlp and ffmpeg must be installed on the server.
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Defaults to the MengAI dev server paths; override only if these differ:
# YT_DLP_JS_RUNTIME=deno:/home/ec2-user/.deno/bin/deno
# YT_DLP_COOKIES_PATH=/opt/mengai-dev/secrets/youtube-cookies.txt
# JUKEBOX_CACHE_MAX_BYTES=1073741824
# SERVER_LOG_FILE=logs/server.txt
