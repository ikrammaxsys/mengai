LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# Optional executable overrides; yt-dlp and ffmpeg must be installed on the server.
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# YT_DLP_JS_RUNTIME=deno
# YT_DLP_REMOTE_COMPONENTS=ejs:github
# YT_DLP_COOKIES_PATH=/absolute/path/to/youtube-cookies.txt
# Or use a browser profile available to the server process instead of a cookie file:
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# JUKEBOX_CACHE_MAX_BYTES=1073741824
# SERVER_LOG_FILE=logs/server.txt
